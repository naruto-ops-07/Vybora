# VYBORA environment overview. Each app reads its own file:
#   apps/web/.env.local        (copy apps/web/.env.example)
#   apps/mobile/.env           (copy apps/mobile/.env.example)
#   Edge Function secrets      (`supabase secrets set ...`, never committed)
#
# PUBLIC (safe in client bundles — access is enforced by RLS):
#   VITE_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY / EXPO_PUBLIC_SUPABASE_ANON_KEY   (anon or publishable key)
#   VITE_SITE_URL / EXPO_PUBLIC_SITE_URL
#   VITE_SENTRY_DSN (optional)
#
# SERVER-ONLY SECRETS (Edge Functions / local scripts — NEVER prefix with VITE_ or EXPO_PUBLIC_):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the cron caller sends to the cleanup-media function (x-cron-secret)
CRON_SECRET=
# Shared secret the Database Webhook sends to send-push (x-webhook-secret)
WEBHOOK_SECRET=
# Optional: Expo push security (enhanced push security in Expo dashboard)
EXPO_ACCESS_TOKEN=
# Optional: restrict CORS on Edge Functions to your web origin
ALLOWED_ORIGIN=http://localhost:5173
