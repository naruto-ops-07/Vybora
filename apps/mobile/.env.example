# Public client configuration (bundled into the app — protected by RLS).
# NEVER put the service-role key in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-or-publishable-key
# Used to build shareable links (https://vybora.app/p/<id>)
EXPO_PUBLIC_SITE_URL=http://localhost:5173
