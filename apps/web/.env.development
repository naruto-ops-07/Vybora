# Local development defaults — points at the Supabase CLI's local stack
# (`supabase start`). The anon key below is a non-secret placeholder; override it
# in apps/web/.env.development.local (git-ignored; Vite ranks .env.development
# above .env.local, so a plain .env.local is ignored by `pnpm dev`).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-placeholder-anon-key-replace-me
VITE_SITE_URL=http://localhost:5173
